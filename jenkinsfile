pipeline {
    agent any  // Use any available agent

    stages {
        stage('Checkout') {
            steps {
                // Pull code from your GitHub repository
                git 'https://github.com/geetikaagrawal19/Capstone_project1.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                // Example for Python project
                sh 'pip install -r requirements.txt'
            }
        }

        stage('Run Tests') {
            steps {
                // Example for Python tests
                sh 'pytest tests/'
            }
        }

        stage('Build or Package') {
            steps {
                // Your build/packaging logic goes here
                echo 'Build step goes here...'
            }
        }

        stage('Deploy') {
            steps {
                // Deploy logic if applicable
                echo 'Deploying the application...'
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished.'
        }
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed.'
        }
    }
}
